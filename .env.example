# Public browser configuration for local development and Vite builds.
# Copy to .env.local and fill in your Supabase project values.
#
# These values are public by design and are embedded in the browser bundle.
# NEVER put a service-role/secret key, Gmail app password, or Vercel token here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-or-publishable-key

# Optional alias used by newer Supabase projects. The client also accepts
# VITE_SUPABASE_KEY, so setting either one is enough.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Supabase Edge Function secrets are configured separately:
# supabase secrets set GMAIL_USER=... GMAIL_APP_PASSWORD=... SITE_URL=...
# See supabase/functions/.env.example.
